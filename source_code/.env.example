# Copy to .env and adjust. All values are optional; defaults live in rag/config.py.
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:1.5b
DATA_DIR=data/handbooks
VECTOR_STORE=vector_store

# Chunking (changing these builds a separate index on next run)
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval and generation
TOP_K=3
SCORE_THRESHOLD=0.6     # fallback if the best chunk's cosine similarity is below this
PROMPT_STYLE=strict     # strict | baseline
TEMPERATURE=0.2
MAX_TOKENS=512
NUM_THREAD=8            # LLM CPU threads (0 = Ollama default = performance cores only)
KEEP_ALIVE=1h           # keep the model loaded between questions
